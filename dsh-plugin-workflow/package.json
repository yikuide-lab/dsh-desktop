{
  "name": "dsh-plugin-workflow",
  "version": "0.2.0",
  "description": "Workflow plugin for DSH Desktop - visual workflow designer and execution engine",
  "license": "MIT",
  "type": "module",
  "main": "lib/plugin.js",
  "types": "lib/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./engine": {
      "types": "./lib/engine/index.d.ts",
      "default": "./lib/engine/index.js"
    }
  },
  "bin": {
    "dsh-workflow": "lib/mcp/index.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/**/*.d.ts",
    "examples/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp": "node lib/mcp/index.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
