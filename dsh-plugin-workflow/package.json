{
  "name": "dsh-plugin-workflow",
  "version": "0.1.0",
  "description": "Workflow plugin for DSH Desktop - visual workflow designer and execution engine",
  "type": "module",
  "main": "lib/plugin.js",
  "types": "lib/types/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./engine": {
      "types": "./lib/types/engine/models.d.ts",
      "default": "./lib/engine/models.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "ui/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
